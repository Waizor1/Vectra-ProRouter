config controller 'main'
	option enabled '1'
	option control_url 'https://api.vectra-pro.net'
	option panel_url 'https://router.vectra-pro.net'
	# Loop cadence and per-request timeout, in seconds (agentcfg expects ints).
	option poll_interval '45'
	option request_timeout '10'
	# Persistent identity/state + operator desired config live under /etc so they
	# survive sysupgrade (see lib/upgrade/keep.d/vectra-controller-pro).
	option state_path '/etc/vectra-controller-pro/state.json'
	option status_path '/var/run/vectra-controller-pro/status.json'
	option xray_config_path '/etc/vectra-controller-pro/xray-desired.json'
	option xray_render_path '/var/run/vectra-controller-pro/xray.json'
	# Wrapper applies GOMEMLIMIT/GOGC caps around the real /usr/bin/xray.
	option xray_binary '/usr/sbin/vctl-xray-wrapper'
	# Canary identity reuse: old agent state to import RouterID + AgentToken from.
	option legacy_state_path '/etc/vectra-controller/state.json'
	# Job-safety resource floors. 0/empty means "use the compile-time default in
	# jobsafety". pre_drop_caches opts into a one-shot vm.drop_caches=3 before the
	# guard fails on low RAM.
	option job_safety_heavy_memory_floor_mb '0'
	option job_safety_storage_memory_floor_mb '0'
	option job_safety_diagnostic_memory_floor_mb '0'
	option job_safety_heavy_overlay_floor_mb '0'
	option job_safety_storage_overlay_floor_mb '0'
	option job_safety_heavy_tmp_floor_mb '0'
	option job_safety_storage_tmp_floor_mb '0'
	option job_safety_diagnostic_tmp_floor_mb '0'
	option job_safety_pre_drop_caches '0'
	# Operator lock on the router UI, for customer routers in a public release.
	# 1 = the UI offers only the simple view, and the router itself refuses the
	# Pro methods (balancers, nodes, logs, pins, probe interval). Read at every
	# UI call: `uci commit` is enough, nothing restarts. A product policy, not a
	# security boundary against root on the router (root can change UCI).
	option ui_lock '0'
	# The setup wizard (LuCI -> Vectra) is finished. 0 on a new router; the
	# package marks a router that already works (the fleet, upgraded) done.
	option setup_done '0'
	# Support before the panel has named its bot: the Telegram bot (username
	# without @, 5-32 of A-Z a-z 0-9 _) the setup wizard's support links open
	# on a box that has never been online. Empty here; set (uci set, uci commit)
	# when boxes are prepared. The panel's bot wins once it names one; an
	# invalid value is ignored.
	option support_bot ''
	# Support shell (remote_shell): '1' lets the panel run commands on this
	# router as root (its run_terminal_command, support's console); anything
	# else refuses them. Not set here on purpose: the package decides it once
	# (uci-defaults) — on, on a new router as on an upgraded one, unless the
	# owner already switched it off — and the router's owner switches it in
	# the router UI. Read at every panel job: `uci commit` is enough, nothing
	# restarts.
	# The router's tune («Разгон роутера», `vctl tune`): at install and at every
	# start vctl sets what gets the most out of this router — compressed swap
	# and the kernel's memory settings on a router under 384 MB, packet
	# steering on two cores or more, software flow offloading — only what
	# nobody set otherwise. 0 = change nothing (what it changed stays;
	# `vctl tune undo` puts it back). `vctl tune` shows what it would do.
	option tune '1'
