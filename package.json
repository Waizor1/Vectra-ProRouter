{
  "name": "vectra-prorouter",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "release:web-slice": "bash ./scripts/build-web-release-slice.sh",
    "ast:rebuild": "bash ./scripts/ast-index.sh rebuild",
    "ast:update": "bash ./scripts/ast-index.sh update",
    "ast:stats": "bash ./scripts/ast-index.sh stats",
    "dev": "pnpm --filter @vectra/web dev",
    "build": "pnpm --filter @vectra/web build",
    "lint": "pnpm --filter @vectra/web lint",
    "typecheck": "pnpm --filter @vectra/web typecheck",
    "test": "pnpm --filter @vectra/web test --run && cd router/vectra-controller-agent && go test ./..."
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "shell-quote": "^1.9.0",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5"
    }
  }
}
