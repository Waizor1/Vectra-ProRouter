# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/vectra"
VECTRA_OPERATOR_USER="operator"
VECTRA_OPERATOR_PASSWORD="change-me"
VECTRA_SECRETS_KEY="replace-with-a-long-random-32-byte-plus-secret"
VECTRA_DEFAULT_CONTROL_DOMAIN="https://router.vectra-pro.net"
VECTRA_ROUTER_API_BASE_URL="https://api.vectra-pro.net"
VECTRA_ARTIFACT_BASE_URL="https://api.vectra-pro.net/artifacts"
VECTRA_POLLING_INTERVAL_SECONDS="45"
VECTRA_WEB_PUSH_PUBLIC_KEY=""
VECTRA_WEB_PUSH_PRIVATE_KEY=""
VECTRA_WEB_PUSH_SUBJECT="mailto:admin@vectra-pro.net"
VECTRA_WEB_PUSH_MONITOR_INTERVAL_SECONDS="60"
VECTRA_AUTO_ONBOARDING_ENABLED="false"
VECTRA_AUTO_RESCUE_ENABLED="false"
VECTRA_AUTO_RESCUE_MONITOR_INTERVAL_SECONDS="60"
VECTRA_AUTO_RESCUE_STALE_SECONDS="300"
VECTRA_AUTO_RESCUE_ESCALATION_SECONDS="600"
VECTRA_TELEGRAM_BOT_TOKEN=""
VECTRA_TELEGRAM_ALLOWED_CHAT_IDS=""
VECTRA_TELEGRAM_WEBHOOK_SECRET=""
VECTRA_TELEGRAM_CALLBACK_SECRET=""
VECTRA_TELEGRAM_DRY_RUN="true"
# in-web | worker-separate (see docker-compose.yml, service `worker`)
VECTRA_BACKGROUND_MODE="in-web"

# ADR-0006 — router onboarding by QR from the Vectra app.
# Partner API shared secret (>= 32 chars). Unset = the partner API is off (503).
VECTRA_PARTNER_SECRET=""
# Further partners, JSON array, e.g.
# [{"id":"bloopcat","brand":"bloopcat","label":"BloopCat","secrets":["<32+ chars>"],"webhookUrl":"https://…/partner/prorouter/webhook","webhookSecret":"<32+ chars>","claimKid":2,"claimPublicKey":"<base64 X25519>","botUsername":"BloopCat_bot"}]
VECTRA_PARTNERS=
# Vectra backend X25519 public key (base64, raw 32 bytes) + key id the router
# seals its QR to. Both unset = routers get no claimKey.
VECTRA_ROUTER_CLAIM_PUBKEY=""
VECTRA_ROUTER_CLAIM_KID=""
# Telegram bot username for the router's "open in Telegram" deep link.
VECTRA_CONNECT_BOT_USERNAME=""
# Webhooks router.claimed / router.ready / router.failed to the Vectra backend.
VECTRA_CONNECT_WEBHOOK_URL=""
VECTRA_CONNECT_WEBHOOK_SECRET=""
