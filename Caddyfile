{
	email {$ACME_EMAIL}
	log {
		output stdout
		format json
	}
}

{$OPERATOR_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	handle /artifacts {
		root * /srv/artifacts
		file_server browse
	}

	handle_path /artifacts/* {
		root * /srv/artifacts
		file_server
	}

	# Caching/relay proxy for the public OpenWrt package + kmod feeds. Routers on
	# ISPs with broken IPv6 cannot reach downloads.openwrt.org (dual-stack Fastly)
	# directly; the bootstrap repoints opkg distfeeds here so dnsmasq-full and the
	# vermagic-locked kmods install via the VPS (which reaches upstream over IPv4).
	# Signature-transparent: opkg verifies the original OpenWrt usign signatures.
	handle_path /openwrt-cache/* {
		reverse_proxy https://downloads.openwrt.org {
			header_up Host downloads.openwrt.org
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy web:3000 {
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}
}

{$ROUTER_API_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	handle /artifacts {
		root * /srv/artifacts
		file_server browse
	}

	handle_path /artifacts/* {
		root * /srv/artifacts
		file_server
	}

	# Caching/relay proxy for the public OpenWrt package + kmod feeds. Routers on
	# ISPs with broken IPv6 cannot reach downloads.openwrt.org (dual-stack Fastly)
	# directly; the bootstrap repoints opkg distfeeds here so dnsmasq-full and the
	# vermagic-locked kmods install via the VPS (which reaches upstream over IPv4).
	# Signature-transparent: opkg verifies the original OpenWrt usign signatures.
	handle_path /openwrt-cache/* {
		reverse_proxy https://downloads.openwrt.org {
			header_up Host downloads.openwrt.org
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/health {
		reverse_proxy web:3000 {
			header_up X-Vectra-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle /api/router/* {
		reverse_proxy web:3000 {
			header_up X-Vectra-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		redir https://{$OPERATOR_DOMAIN}{uri} 308
	}
}
