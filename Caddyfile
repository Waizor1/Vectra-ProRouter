{
	email {$ACME_EMAIL}
	# The default logger also carries reverse_proxy errors, request and all:
	# the same redaction as the access logs (a router-sub token in the path,
	# a router token or a sealed router User-Agent in a header).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Vectra-Router-Token delete
				request>headers>X-Vectra-Install-Session delete
				request>headers>User-Agent delete
				request>uri regexp "^/router-sub/[^/?]+" "/router-sub/REDACTED"
			}
		}
	}
}

{$OPERATOR_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# Access logs without the routers' credentials: a router token or an
	# install session in a header must not end up in `docker logs`.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Vectra-Router-Token delete
				request>headers>X-Vectra-Install-Session delete
				request>uri regexp "^/router-sub/[^/?]+" "/router-sub/REDACTED"
			}
		}
	}

	# The installer behind a short link:
	#   wget -O /tmp/vectra https://router.vectra-pro.net/install && sh /tmp/vectra
	# A browser opening /install still gets the panel page; wget gets the script.
	@installer {
		path /install /install.sh
		not {
			path /install
			header Accept *text/html*
		}
	}
	handle @installer {
		root * /srv/artifacts
		rewrite * /openwrt/pro-canary/install.sh
		header Content-Type "text/x-shellscript; charset=utf-8"
		header Cache-Control "no-cache"
		file_server
	}

	handle /artifacts {
		root * /srv/artifacts
		file_server
	}

	handle_path /artifacts/* {
		root * /srv/artifacts
		file_server
	}

	# Caching/relay proxy for the public OpenWrt package + kmod feeds. Routers on
	# ISPs with broken IPv6 cannot reach downloads.openwrt.org (dual-stack Fastly)
	# directly; the bootstrap repoints opkg distfeeds here so dnsmasq-full and the
	# vermagic-locked kmods install via the VPS (which reaches upstream over IPv4).
	# Signature-transparent: opkg verifies the original OpenWrt usign signatures.
	handle_path /openwrt-cache/* {
		@owcwrite not method GET HEAD
		respond @owcwrite 405
		reverse_proxy https://downloads.openwrt.org {
			header_up Host downloads.openwrt.org
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	# The partner API's bodies are small (the route caps them too).
	request_body /api/partner/* {
		max_size 16KB
	}

	handle {
		reverse_proxy web:3000 {
			# The rate limiters trust this header: it must be ours, never the client's.
			header_up X-Vectra-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}
}

{$ROUTER_API_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# Access logs without the routers' credentials: a router token or an
	# install session in a header must not end up in `docker logs`.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Vectra-Router-Token delete
				request>headers>X-Vectra-Install-Session delete
				request>headers>User-Agent delete
				request>uri regexp "^/router-sub/[^/?]+" "/router-sub/REDACTED"
			}
		}
	}

	# The installer behind a short link:
	#   wget -O /tmp/vectra https://router.vectra-pro.net/install && sh /tmp/vectra
	# A browser opening /install still gets the panel page; wget gets the script.
	@installer {
		path /install /install.sh
		not {
			path /install
			header Accept *text/html*
		}
	}
	handle @installer {
		root * /srv/artifacts
		rewrite * /openwrt/pro-canary/install.sh
		header Content-Type "text/x-shellscript; charset=utf-8"
		header Cache-Control "no-cache"
		file_server
	}

	handle /artifacts {
		root * /srv/artifacts
		file_server
	}

	handle_path /artifacts/* {
		root * /srv/artifacts
		file_server
	}

	# Caching/relay proxy for the public OpenWrt package + kmod feeds. Routers on
	# ISPs with broken IPv6 cannot reach downloads.openwrt.org (dual-stack Fastly)
	# directly; the bootstrap repoints opkg distfeeds here so dnsmasq-full and the
	# vermagic-locked kmods install via the VPS (which reaches upstream over IPv4).
	# Signature-transparent: opkg verifies the original OpenWrt usign signatures.
	handle_path /openwrt-cache/* {
		@owcwrite not method GET HEAD
		respond @owcwrite 405
		reverse_proxy https://downloads.openwrt.org {
			header_up Host downloads.openwrt.org
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /api/health {
		reverse_proxy web:3000 {
			header_up X-Vectra-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Vectra Connect router subscriptions (ADR-0006). A router fetches its
	# first config before it has a tunnel, and Russian ISPs stall TLS to the
	# app backend host after ~16 KB; this host is not stalled. The backend
	# verifies the router-signed path and query, not the host.
	@routersubbad {
		path /router-sub/*
		not {
			method GET HEAD
			path_regexp ^/router-sub/[A-Za-z0-9._~-]+(/json)?$
		}
	}
	handle @routersubbad {
		respond 404
	}

	handle /router-sub/* {
		request_body {
			max_size 1KB
		}
		reverse_proxy https://api-app.vectra-pro.net {
			header_up Host api-app.vectra-pro.net
			transport http {
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}

	handle /api/router/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy web:3000 {
			header_up X-Vectra-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Server-to-server API for the Vectra app's backend (router claims,
	# ADR-0006). Every request is HMAC-signed; the route checks it itself.
	handle /api/partner/* {
		request_body {
			max_size 16KB
		}
		reverse_proxy web:3000 {
			header_up X-Vectra-Client-IP {remote_host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		redir https://{$OPERATOR_DOMAIN}{uri} 308
	}
}
