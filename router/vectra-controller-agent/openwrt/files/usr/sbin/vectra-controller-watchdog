#!/bin/sh
# vectra-controller-watchdog: best-effort recovery for a stuck/missing
# vectra-controller-agent. Runs from cron every 5 min. Designed for the
# AX3000T fleet where a botched controller self-update can leave the router
# with no live controller AND no way for the panel to push a fix (panel only
# sees fresh check-ins; no check-ins = no remote remediation possible).
#
# Recovery policy (in order):
#   1. If the binary exists and is executable but no process: nudge init.d
#      to restart. Cheap, idempotent, fixes "procd gave up after 20 retries"
#      cases.
#   2. If the binary is missing or zero-sized: when a self-update left a
#      rollback copy (/etc/vectra-controller/update-rollback, written by the
#      panel's update command), hand it to that update guard, which restores
#      the previous version offline. Otherwise log a CRITICAL marker to
#      syslog so the next operator who SSHes in immediately sees the
#      situation. Don't try to download a replacement — we can't trust the
#      router has network at this point, and a botched download would only
#      make things worse.
#   Never enable/start (or restore) the legacy agent while vctl
#   (vectra-controller-pro) owns the router, or while its init script is
#   disabled on purpose.
#   3. Dead-man's switch (GAP-2): even when the agent process is alive and
#      healthy, the router can be PERMANENTLY unreachable if PassWall2's
#      transparent proxy routes the controller's own panel traffic through a
#      DEAD proxy node (active shunt default_node is a proxy + mainSwitch=1).
#      The agent can then never reach api.vectra-pro.net, never check in, and
#      the panel can never push a fix — a NAT'd box with no inbound path. Two
#      real routers were lost this way. The switch is ARMED when the agent has
#      had no SUCCESSFUL control-plane contact for longer than a threshold,
#      but it only FIRES (passwall2 disabled + restart) on proof that the
#      proxy itself is dead: every candidate node fails
#      `test.sh url_test_node`, the same verdict the agent's rescue uses.
#      A stale panel contact alone never switches the VPN off — otherwise a
#      panel outage (VPS down, IP blocked, certificate expired) would take the
#      whole fleet to direct at once. The direct it creates is OWNED by the
#      watchdog (persistent marker) and undone by the watchdog as soon as a
#      node answers again, whatever the panel's state. Ownership passes to the
#      agent only when the agent itself writes the main switch (it deletes the
#      marker) or its recovery takes over the park.
#   4. If init.d isn't installed: out of scope (router predates this
#      package), exit silently.
#
# Failure mode this script SOLVES (1/2): r27 incident on totchto-filiciy where
# a binary-less .ipk was installed and procd exhausted its respawn retries
# (15s threshold × 5s wait × 20 retries = ~100s), leaving the router with
# no controller and no remote recovery path.
#
# Failure mode this script SOLVES (3): the "proxy strand" — agent alive but
# its panel traffic is black-holed through a dead proxy. Also covers the
# abrupt-power-loss case: after an unclean reboot the box may come up
# PassWall-enabled with a dead proxy before the agent re-contacts the panel;
# state.json (in preserved /etc/vectra-controller) keeps last contact across
# reboots, so "now - last_contact > threshold" still trips and frees the box.
#
# Failure mode this script does NOT solve: total network loss for reasons
# OTHER than the proxy strand (dead WAN, hardware failure), or a binary that
# crashes immediately on startup. For those the operator still needs LAN/SSH.

set -u

LOG_TAG="vectra-controller-watchdog"
INIT_SCRIPT="/etc/init.d/vectra-controller"
AGENT_BIN="/usr/sbin/vectra-controller-agent"
STATE_FILE="/var/run/vectra-controller-watchdog.state"
LAST_RESTART_FILE="/var/run/vectra-controller-watchdog.last-restart"
# Records the boot epoch the first time the dead-man's switch runs after a
# reboot. Used to grant an onboarded box a grace window before treating a
# missing/empty last-contact timestamp as "stale" (so we don't fight a
# legitimate first-boot onboarding that simply hasn't checked in yet).
DEADMAN_BOOT_MARKER="/var/run/vectra-controller-watchdog.boot-epoch"

# Throttle restart attempts. If we just nudged the service in the past N
# seconds, don't nudge again — give procd respawn a chance to actually do
# its work without us thrashing on top of it.
RESTART_THROTTLE_SECONDS=300

# Dead-man's switch: how long the controller may go without a SUCCESSFUL
# control-plane contact before we fail safe to direct. Default 15 min;
# overridable via uci option `vectra-controller.main.deadman_threshold`
# (seconds) or the VECTRA_DEADMAN_THRESHOLD_SECONDS env var. Chosen well
# above the agent's poll cadence (45s) + rescue settle windows so a healthy
# router never trips, while a truly stranded one recovers within ~3 cron
# ticks. Set to 0 to disable the dead-man's switch entirely.
DEADMAN_THRESHOLD_SECONDS=900

# Grace window after boot before a missing/empty last-contact timestamp on an
# already-onboarded router counts as "stale". Lets first-boot onboarding (and
# post-reboot re-contact) complete before we would flip to direct on the
# strength of an absent timestamp alone. A timestamp that EXISTS but is old is
# trusted immediately (it survived reboot), so this only gates the empty case.
DEADMAN_BOOT_GRACE_SECONDS=900

# Path to the agent's persisted state. Default matches 90_vectra_controller_defaults
# / render-config.sh; overridable via the same uci option the agent reads.
STATE_JSON_DEFAULT="/etc/vectra-controller/state.json"

# Persistent proof that the watchdog itself switched PassWall off. Lives next
# to state.json (preserved across reboot and sysupgrade) so a reboot during a
# panel outage does not orphan the direct: the next boot still knows whose it
# is and restores proxy once a node answers. Holds the epoch of the switch.
DEADMAN_OWNER_MARKER="/etc/vectra-controller/watchdog-direct"

# Epoch of the watchdog's last PassWall flip (either direction). Flap damping:
# the watchdog never flips PassWall more than once per cooldown.
DEADMAN_LAST_ACTION_FILE="/var/run/vectra-controller-watchdog.last-action"
DEADMAN_ACTION_COOLDOWN_SECONDS=900

# The agent switches PassWall on for a ~75 s warmup when it retries the proxy
# (phase passwall_retry_wait) and re-disables it itself if the retry fails.
# The watchdog keeps out of that window so it can never kill a retry the agent
# is still judging; a retry older than this is treated as abandoned.
DEADMAN_AGENT_RETRY_GRACE_SECONDS=900

# Proxy verdict: the agent's own evidence (proxyNodeReachableForRecovery).
DEADMAN_URL_TEST="/usr/share/passwall2/test.sh"
DEADMAN_URL_TEST_TIMEOUT_SECONDS=30
# test.sh starts `app.sh run_socks flag=url_test_<node>` (a temporary xray)
# plus a curl, and only cleans them up itself when it finishes. Killing
# test.sh on timeout leaves both behind; they are reaped by name and their
# config is removed from here.
DEADMAN_PASSWALL_TMP_DIR="/tmp/etc/passwall2"
# Set by the timeout watcher when it had to kill test.sh.
DEADMAN_PROBE_TIMEOUT_FLAG="/var/run/vectra-controller-watchdog.probe-timeout"
# Shared with the agent (url_test_lock.go): test.sh kills every process named
# url_test_<node> when it finishes, so two concurrent probes of one node kill
# each other's xray and both read "dead". One url_test_node at a time.
# Content "<epoch> <owner>"; older than DEADMAN_URL_TEST_LOCK_STALE_SECONDS
# is stale.
DEADMAN_URL_TEST_LOCK_DIR="/var/run/vectra-url-test.lock"
DEADMAN_URL_TEST_LOCK_STALE_SECONDS=120
DEADMAN_URL_TEST_LOCK_WAIT_SECONDS=60
# Total time one verdict may spend waiting for the lock and probing. Each
# candidate can cost a lock wait plus a 30 s probe; without a cap a shunt with
# many slots could outlast the 600 s run lock and let the next cron run start
# alongside. Candidates not reached in time leave the verdict inconclusive.
DEADMAN_RUN_PROBE_BUDGET_SECONDS=240
# At most one proxy verdict (and so one batch of temporary xrays) per this
# many seconds, whichever direction is being judged.
DEADMAN_PROBE_INTERVAL_SECONDS=900
DEADMAN_LAST_PROBE_FILE="/var/run/vectra-controller-watchdog.last-probe"
DEADMAN_SHUNT_OPTIONS="WorldProxy YouTube GooglePlay Proxy ProxyGame Tiktok Special default_node"
# url_test_node starts a temporary xray. Below this much MemAvailable the
# verdict is "inconclusive" (=> no action) rather than risking an OOM on the
# 234 MB boxes; matches the agent's heavy-job memory floor.
DEADMAN_PROBE_MEM_FLOOR_MB=40
MEMINFO_FILE="/proc/meminfo"

# Rollback copy and guard left by the panel's controller self-update command
# (router/vectra-controller-agent/openwrt/update-guard). Not part of this
# package: they exist only while an update is being verified.
UPDATE_GUARD="/etc/vectra-controller/update-rollback/guard.sh"
UPDATE_GUARD_META="/etc/vectra-controller/update-rollback/meta"

# vctl (vectra-controller-pro) owning the router: the legacy agent stays off.
VCTL_INIT="/etc/init.d/vectra-controller-pro"
VCTL_HANDOVER_MARKERS="/etc/vectra-controller-pro/.legacy-agent-disabled-by-vctl /tmp/vectra-trial.d/.legacy-agent-disabled-by-vctl"

# Serialises overlapping cron runs (a slow url_test_node must not let the next
# tick act on half-finished state). A lock older than this is stale.
DEADMAN_LOCK_DIR="/var/run/vectra-controller-watchdog.lock"
DEADMAN_LOCK_STALE_SECONDS=600

log() {
	# Use logger so the action surfaces in `logread` alongside other procd
	# events. Stderr fallback for hosts where logger isn't installed (rare on
	# OpenWrt but possible on minimal builds).
	if command -v logger >/dev/null 2>&1; then
		logger -t "$LOG_TAG" "$1"
	else
		printf '[%s] %s\n' "$LOG_TAG" "$1" >&2
	fi
}

now_epoch() {
	date +%s
}

read_last_restart_epoch() {
	if [ -f "$LAST_RESTART_FILE" ]; then
		cat "$LAST_RESTART_FILE" 2>/dev/null || echo 0
	else
		echo 0
	fi
}

mark_restart_attempt() {
	mkdir -p "$(dirname "$LAST_RESTART_FILE")" 2>/dev/null || true
	now_epoch > "$LAST_RESTART_FILE"
}

# --- Dead-man's switch helpers (GAP-2) -------------------------------------
#
# These are split into small, side-effect-free helpers so the decision logic
# can be unit-tested off-router. The only impure pieces (reading state.json,
# reading uci, restarting passwall2) are isolated in their own functions and
# stubbed by the test harness.

# Resolve the configured state.json path (operator may have moved it). Falls
# back to the package default. uci absence is tolerated (fresh/odd builds).
deadman_state_path() {
	value="$(uci -q get vectra-controller.main.state_path 2>/dev/null || true)"
	if [ -n "$value" ]; then
		printf '%s' "$value"
	else
		printf '%s' "$STATE_JSON_DEFAULT"
	fi
}

# Resolve the staleness threshold in seconds. Precedence: env override > uci
# option > compile-time default. Non-numeric or negative values fall back to
# the default so a typo can never silently disable the safety net.
deadman_threshold_seconds() {
	value="${VECTRA_DEADMAN_THRESHOLD_SECONDS:-}"
	if [ -z "$value" ]; then
		value="$(uci -q get vectra-controller.main.deadman_threshold 2>/dev/null || true)"
	fi
	case "$value" in
	'' | *[!0-9]*)
		printf '%s' "$DEADMAN_THRESHOLD_SECONDS"
		;;
	*)
		printf '%s' "$value"
		;;
	esac
}

# Read a top-level or nested string field out of state.json via jsonfilter
# (the OpenWrt idiom already used by render-config.sh). $1 is a jsonfilter
# expression like '@.router_id' or '@.control_plane_recovery.last_successful_control_plane_at'.
# Empty string when the file or field is absent. Never errors out the script.
deadman_state_field() {
	expression="$1"
	state_file="$(deadman_state_path)"
	[ -f "$state_file" ] || return 0
	jsonfilter -i "$state_file" -e "$expression" 2>/dev/null || true
}

# Strip leading zeros from a numeric string so $(( )) never mis-parses it as
# octal (e.g. "09"). Pure parameter expansion — no `10#` base prefix, which is
# a bashism BusyBox ash / dash reject. "" -> "0", "00" -> "0", "09" -> "9".
deadman_strip_leading_zeros() {
	value="$1"
	while :; do
		case "$value" in
		0[0-9]*) value="${value#0}" ;;
		*) break ;;
		esac
	done
	[ -n "$value" ] || value=0
	printf '%s' "$value"
}

# Convert an RFC3339 timestamp (as written by the agent's recovery.FormatTime,
# e.g. 2026-06-29T12:34:56Z, always UTC) to epoch seconds. Prints nothing on
# failure (caller treats empty as "no usable timestamp"). BusyBox `date -d`
# RFC3339 support is inconsistent across builds, so we first try it and fall
# back to a fully deterministic pure-shell computation that needs no external
# parsing. Only the UTC `Z` / `+00:00` form is produced by the agent, so we
# normalise to UTC and ignore any offset.
deadman_rfc3339_to_epoch() {
	ts="$1"
	[ -n "$ts" ] || return 0

	# Fast path: let date parse it if this build can.
	epoch="$(date -u -d "$ts" +%s 2>/dev/null || true)"
	case "$epoch" in
	'' | *[!0-9]*) : ;;
	*)
		printf '%s' "$epoch"
		return 0
		;;
	esac

	# Deterministic fallback. Strip a trailing zone designator (Z or +00:00 /
	# -00:00 — the agent only ever emits UTC) and split the calendar fields.
	core="${ts%Z}"
	core="${core%+00:00}"
	core="${core%-00:00}"
	# Replace the date/time separators with spaces so `set --` can field-split
	# without invoking a subshell tool. Expected shape: YYYY MM DD hh mm ss.
	normalized="$(printf '%s' "$core" | tr 'T:-' '   ')"
	# shellcheck disable=SC2086
	set -- $normalized
	[ "$#" -ge 6 ] || return 0
	y="$1"; mo="$2"; d="$3"; h="$4"; mi="$5"; s="$6"
	case "$y$mo$d$h$mi$s" in
	'' | *[!0-9]*) return 0 ;;
	esac

	# Strip leading zeros portably (no octal mis-parse, no `10#` bashism).
	y="$(deadman_strip_leading_zeros "$y")"
	mo="$(deadman_strip_leading_zeros "$mo")"
	d="$(deadman_strip_leading_zeros "$d")"
	h="$(deadman_strip_leading_zeros "$h")"
	mi="$(deadman_strip_leading_zeros "$mi")"
	s="$(deadman_strip_leading_zeros "$s")"
	[ "$mo" -ge 1 ] 2>/dev/null && [ "$mo" -le 12 ] 2>/dev/null || return 0

	# Days from civil date (Howard Hinnant's algorithm), valid for all dates.
	yy=$y
	if [ "$mo" -le 2 ]; then
		yy=$((yy - 1))
	fi
	# era = floor(yy/400). yy is always >= 0 for real RFC3339 years (>= 0001),
	# but keep an explicit non-negative branch rather than relying on the C
	# ternary operator, whose support in BusyBox ash is not guaranteed.
	if [ "$yy" -ge 0 ]; then
		era=$(( yy / 400 ))
	else
		era=$(( (yy - 399) / 400 ))
	fi
	yoe=$((yy - era * 400))
	mp=$(( (mo + 9) % 12 ))
	doy=$(( (153 * mp + 2) / 5 + d - 1 ))
	doe=$(( yoe * 365 + yoe / 4 - yoe / 100 + doy ))
	days=$(( era * 146097 + doe - 719468 ))
	printf '%s' "$(( days * 86400 + h * 3600 + mi * 60 + s ))"
}

# Pure decision: should we fail safe to direct? All inputs are plain values so
# this can be exercised by the test harness without touching the system.
#
#   $1 last_contact_epoch  epoch secs of last successful control-plane contact,
#                          or empty string when there is no usable timestamp.
#   $2 now_epoch           current epoch secs.
#   $3 passwall_enabled    "1" when passwall2 is currently enabled, else "0".
#   $4 is_onboarded        "1" when the router has credentials (router_id +
#                          agent_token) in state.json, else "0".
#   $5 boot_grace_ok       "1" when we are past the post-boot grace window
#                          (only consulted for the empty-timestamp case).
#
# Returns 0 (fail safe) only when ALL hold:
#   - passwall2 is enabled (nothing to do if already direct),
#   - the router is onboarded (never disable proxy on a fresh box),
#   - AND either: a timestamp exists and is older than the threshold, OR no
#     timestamp exists but we are past the boot grace (onboarded box that has
#     not managed a single contact long after boot == stranded).
# Returns 1 otherwise. The threshold is read fresh here so callers/tests can
# override it via env/uci.
should_fail_safe_to_direct() {
	last_contact_epoch="$1"
	dm_now_epoch="$2"
	passwall_enabled="$3"
	is_onboarded="$4"
	boot_grace_ok="$5"

	threshold="$(deadman_threshold_seconds)"
	# Threshold 0 means the dead-man's switch is disabled.
	[ "$threshold" -gt 0 ] 2>/dev/null || return 1

	# Guard (b): nothing to do if proxy is already off.
	[ "$passwall_enabled" = "1" ] || return 1
	# Guard (a): never touch a box that has not onboarded.
	[ "$is_onboarded" = "1" ] || return 1

	if [ -n "$last_contact_epoch" ]; then
		case "$last_contact_epoch" in
		*[!0-9]*) return 1 ;;
		esac
		age=$((dm_now_epoch - last_contact_epoch))
		# Negative age (clock skew / time jump backwards) is not evidence of a
		# strand; treat as fresh and wait for the next tick.
		[ "$age" -lt 0 ] && return 1
		[ "$age" -gt "$threshold" ] && return 0
		return 1
	fi

	# No usable timestamp. Only treat as stranded once past the boot grace, so
	# first-boot onboarding is not pre-empted.
	[ "$boot_grace_ok" = "1" ] && return 0
	return 1
}

# Record (once per boot) the epoch at which the dead-man's switch first saw
# this boot, then report whether we are past the boot grace window. crond and
# the marker both live under /var/run, which is cleared on reboot, so a fresh
# boot starts the grace clock over.
deadman_past_boot_grace() {
	now="$1"
	if [ ! -f "$DEADMAN_BOOT_MARKER" ]; then
		mkdir -p "$(dirname "$DEADMAN_BOOT_MARKER")" 2>/dev/null || true
		printf '%s' "$now" > "$DEADMAN_BOOT_MARKER" 2>/dev/null || true
		# Just observed this boot; definitionally still inside the grace window.
		return 1
	fi
	boot_epoch="$(cat "$DEADMAN_BOOT_MARKER" 2>/dev/null || echo "$now")"
	case "$boot_epoch" in
	'' | *[!0-9]*) boot_epoch="$now" ;;
	esac
	elapsed=$((now - boot_epoch))
	[ "$elapsed" -ge "$DEADMAN_BOOT_GRACE_SECONDS" ] && return 0
	return 1
}

# Impure action: fail safe to direct using the EXACT uci path the agent's own
# rescue uses (setPasswallMainSwitch in rescue_runtime.go):
#   set passwall2.@global[0].enabled='0'; commit passwall2; passwall2 restart.
# Idempotent: only the caller decides whether to invoke this.
deadman_fail_safe_to_direct() {
	uci -q set passwall2.@global[0].enabled='0' 2>/dev/null || true
	uci -q commit passwall2 2>/dev/null || true
	if [ -x /etc/init.d/passwall2 ]; then
		/etc/init.d/passwall2 restart >/dev/null 2>&1 || true
	fi
}

# Impure action: undo the watchdog's own direct (same uci path, enabled=1).
deadman_restore_proxy() {
	uci -q set passwall2.@global[0].enabled='1' 2>/dev/null || true
	uci -q commit passwall2 2>/dev/null || true
	if [ -x /etc/init.d/passwall2 ]; then
		/etc/init.d/passwall2 restart >/dev/null 2>&1 || true
	fi
}

deadman_lower() {
	printf '%s' "$1" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz'
}

# A node id that names a real outbound (not a PassWall pseudo-target).
deadman_is_concrete_node() {
	case "$(deadman_lower "$1")" in
	'' | _default | _direct | _blackhole) return 1 ;;
	esac
	return 0
}

deadman_is_virtual_protocol() {
	case "$1" in
	_shunt | _balancing | _urltest) return 0 ;;
	esac
	return 1
}

deadman_node_protocol() {
	deadman_lower "$(uci -q get "passwall2.$1.protocol" 2>/dev/null || true)"
}

# Print the node ids whose answer decides "is the proxy alive", one per line,
# deduplicated. Mirrors the agent's proxyNodeReachableForRecovery: the
# selected node when it is concrete; for a shunt, every concrete slot node
# among the agent's probe options. Other virtual selections print nothing.
deadman_proxy_candidates() {
	selected="$(uci -q get 'passwall2.@global[0].node' 2>/dev/null || true)"
	deadman_is_concrete_node "$selected" || return 0
	protocol="$(deadman_node_protocol "$selected")"
	if [ -z "$protocol" ] || ! deadman_is_virtual_protocol "$protocol"; then
		printf '%s\n' "$selected"
		return 0
	fi
	[ "$protocol" = "_shunt" ] || return 0
	seen=" "
	for option in $DEADMAN_SHUNT_OPTIONS; do
		node="$(uci -q get "passwall2.$selected.$option" 2>/dev/null || true)"
		deadman_is_concrete_node "$node" || continue
		case "$seen" in *" $node "*) continue ;; esac
		node_protocol="$(deadman_node_protocol "$node")"
		[ -n "$node_protocol" ] || continue
		deadman_is_virtual_protocol "$node_protocol" && continue
		seen="$seen$node "
		printf '%s\n' "$node"
	done
}

deadman_probe_memory_ok() {
	avail_kb="$(awk '/^MemAvailable:/ { print $2; exit }' "$MEMINFO_FILE" 2>/dev/null || true)"
	case "$avail_kb" in
	'' | *[!0-9]*) return 0 ;;
	esac
	[ $((avail_kb / 1024)) -ge "$DEADMAN_PROBE_MEM_FLOOR_MB" ]
}

# Kill what a killed test.sh leaves behind for this node: the run_socks/xray
# pair named url_test_<node> (test.sh itself is excluded, as upstream does)
# and its temporary config. `ps w` + a bracketed pattern so the grep never
# matches itself; the trailing class keeps node "a" from matching "ab".
deadman_reap_url_test() {
	reap_pids="$(ps w 2>/dev/null | grep -E "[u]rl_test_$1([^A-Za-z0-9_]|\$)" | grep -v 'test\.sh' | awk '{ print $1 }')"
	if [ -n "$reap_pids" ]; then
		# shellcheck disable=SC2086
		kill -9 $reap_pids 2>/dev/null || true
	fi
	rm -f "$DEADMAN_PASSWALL_TMP_DIR"/*url_test_"$1".json \
		"$DEADMAN_PASSWALL_TMP_DIR"/*url_test_"$1"[!A-Za-z0-9_]*.json 2>/dev/null || true
}

# Lock token: our epoch and pid, so a release never removes a lock someone
# else took over after declaring ours stale.
deadman_lock_token() {
	printf '%s %s' "$1" "$$"
}

# $1 lock dir, $2 now, $3 stale seconds. 0 = acquired.
deadman_try_lock() {
	if mkdir "$1" 2>/dev/null; then
		deadman_lock_token "$2" > "$1/owner" 2>/dev/null || true
		return 0
	fi
	held_epoch="$(cut -d ' ' -f 1 "$1/owner" 2>/dev/null || true)"
	case "$held_epoch" in
	'' | *[!0-9]*) held_epoch="" ;;
	esac
	if [ -z "$held_epoch" ] || [ $(($2 - held_epoch)) -ge "$3" ] || [ $(($2 - held_epoch)) -lt 0 ]; then
		rm -rf "$1" 2>/dev/null || true
		if mkdir "$1" 2>/dev/null; then
			deadman_lock_token "$2" > "$1/owner" 2>/dev/null || true
			return 0
		fi
	fi
	return 1
}

# $1 lock dir, $2 the epoch it was taken at. Removes it only if still ours.
deadman_unlock() {
	if [ "$(cat "$1/owner" 2>/dev/null || true)" = "$(deadman_lock_token "$2")" ]; then
		rm -rf "$1" 2>/dev/null || true
	fi
}

# Run test.sh url_test_node <node> with a timeout that needs nothing but sh:
# the `timeout` applet is not guaranteed in OpenWrt's BusyBox (PassWall
# 26.7.16+ had to add a coreutils-timeout dependency), so nothing relies on it. Prints test.sh's answer;
# returns 124 when it had to be killed (after reaping its leftovers).
deadman_url_test_node() {
	rm -f "$DEADMAN_PROBE_TIMEOUT_FLAG" 2>/dev/null || true
	"$DEADMAN_URL_TEST" url_test_node "$1" 2>/dev/null &
	probe_pid=$!
	(
		sleep "$DEADMAN_URL_TEST_TIMEOUT_SECONDS"
		: > "$DEADMAN_PROBE_TIMEOUT_FLAG"
		kill -9 "$probe_pid" 2>/dev/null
	) </dev/null >/dev/null 2>&1 &
	watcher_pid=$!
	wait "$probe_pid" 2>/dev/null
	kill "$watcher_pid" 2>/dev/null || true
	if [ -f "$DEADMAN_PROBE_TIMEOUT_FLAG" ]; then
		rm -f "$DEADMAN_PROBE_TIMEOUT_FLAG" 2>/dev/null || true
		deadman_reap_url_test "$1"
		return 124
	fi
	return 0
}

# One node under the shared url_test lock, waiting at most $2 seconds for it.
# Prints the answer; returns 3 when the lock could not be had (the agent is
# probing): that node is unjudged.
deadman_url_test_node_locked() {
	waited=0
	while :; do
		lock_now="$(now_epoch)"
		deadman_try_lock "$DEADMAN_URL_TEST_LOCK_DIR" "$lock_now" "$DEADMAN_URL_TEST_LOCK_STALE_SECONDS" && break
		[ "$waited" -lt "$2" ] || return 3
		sleep 1
		waited=$((waited + 1))
	done
	deadman_url_test_node "$1"
	probe_rc=$?
	deadman_unlock "$DEADMAN_URL_TEST_LOCK_DIR" "$lock_now"
	return "$probe_rc"
}

# Proxy verdict from url_test_node. Sets DEADMAN_VERDICT_DETAIL for logging.
#   rc 0 = alive (a candidate answered 200/204)
#   rc 1 = dead  (at least one candidate probed, none answered)
#   rc 2 = inconclusive (no test.sh, no candidate, or too little RAM to probe)
deadman_proxy_verdict() {
	DEADMAN_VERDICT_DETAIL=""
	if [ ! -x "$DEADMAN_URL_TEST" ]; then
		DEADMAN_VERDICT_DETAIL="no $DEADMAN_URL_TEST"
		return 2
	fi
	if ! deadman_probe_memory_ok; then
		DEADMAN_VERDICT_DETAIL="MemAvailable below ${DEADMAN_PROBE_MEM_FLOOR_MB} MB"
		return 2
	fi
	candidates="$(deadman_proxy_candidates)"
	if [ -z "$candidates" ]; then
		DEADMAN_VERDICT_DETAIL="no concrete proxy node to test"
		return 2
	fi
	unjudged=0
	verdict_started="$(now_epoch)"
	for node in $candidates; do
		budget_used=$(($(now_epoch) - verdict_started))
		if [ "$budget_used" -lt 0 ] || [ "$budget_used" -ge "$DEADMAN_RUN_PROBE_BUDGET_SECONDS" ]; then
			# Out of time: the nodes not reached are unjudged.
			unjudged=1
			DEADMAN_VERDICT_DETAIL="${DEADMAN_VERDICT_DETAIL}${DEADMAN_VERDICT_DETAIL:+, }probe budget ${DEADMAN_RUN_PROBE_BUDGET_SECONDS}s spent"
			break
		fi
		lock_wait=$((DEADMAN_RUN_PROBE_BUDGET_SECONDS - budget_used))
		[ "$lock_wait" -le "$DEADMAN_URL_TEST_LOCK_WAIT_SECONDS" ] || lock_wait="$DEADMAN_URL_TEST_LOCK_WAIT_SECONDS"
		raw_answer="$(deadman_url_test_node_locked "$node" "$lock_wait")"
		probe_rc=$?
		answer="$(printf '%s' "$raw_answer" | tr -d ' \t\r\n')"
		if [ "$probe_rc" -eq 3 ]; then
			unjudged=1
			DEADMAN_VERDICT_DETAIL="${DEADMAN_VERDICT_DETAIL}${DEADMAN_VERDICT_DETAIL:+, }$node=busy"
			continue
		fi
		[ "$probe_rc" -eq 124 ] && answer="timeout"
		case "$answer" in
		200 | 204 | 200:* | 204:*)
			DEADMAN_VERDICT_DETAIL="node $node answered $answer"
			return 0
			;;
		esac
		DEADMAN_VERDICT_DETAIL="${DEADMAN_VERDICT_DETAIL}${DEADMAN_VERDICT_DETAIL:+, }$node=${answer:-none}"
	done
	# A node the agent was probing at the time is not evidence of death.
	[ "$unjudged" -eq 1 ] && return 2
	return 1
}

# Probe budget: at most one verdict per DEADMAN_PROBE_INTERVAL_SECONDS. A
# clock that went backwards never blocks a probe.
deadman_probe_due() {
	last_probe="$(deadman_read_epoch_file "$DEADMAN_LAST_PROBE_FILE")"
	[ -n "$last_probe" ] || return 0
	probe_age=$(($1 - last_probe))
	[ "$probe_age" -lt 0 ] && return 0
	[ "$probe_age" -ge "$DEADMAN_PROBE_INTERVAL_SECONDS" ]
}

deadman_mark_probe() {
	mkdir -p "$(dirname "$DEADMAN_LAST_PROBE_FILE")" 2>/dev/null || true
	printf '%s' "$1" > "$DEADMAN_LAST_PROBE_FILE" 2>/dev/null || true
}

deadman_read_epoch_file() {
	value="$(cat "$1" 2>/dev/null || true)"
	case "$value" in
	'' | *[!0-9]*) printf '' ;;
	*) printf '%s' "$value" ;;
	esac
}

# Has the flap-damping cooldown passed since the watchdog's last flip?
# $1 now, $2 "restore" lets a backwards clock count as elapsed: giving back a
# proven-alive proxy is the safe direction, cutting one is not.
deadman_action_cooldown_elapsed() {
	last="$(deadman_read_epoch_file "$DEADMAN_LAST_ACTION_FILE")"
	[ -n "$last" ] || return 0
	age=$(($1 - last))
	if [ "$age" -lt 0 ]; then
		[ "${2:-}" = "restore" ]
		return
	fi
	[ "$age" -ge "$DEADMAN_ACTION_COOLDOWN_SECONDS" ]
}

deadman_mark_action() {
	mkdir -p "$(dirname "$DEADMAN_LAST_ACTION_FILE")" 2>/dev/null || true
	printf '%s' "$1" > "$DEADMAN_LAST_ACTION_FILE" 2>/dev/null || true
}

# Is the agent in the middle of a proxy retry it will judge itself?
deadman_agent_retry_in_progress() {
	now="$1"
	phase="$(deadman_state_field '@.control_plane_recovery.phase')"
	[ "$phase" = "passwall_retry_wait" ] || return 1
	retry_epoch="$(deadman_rfc3339_to_epoch "$(deadman_state_field '@.control_plane_recovery.last_passwall_retry_at')")"
	[ -n "$retry_epoch" ] || return 1
	age=$((now - retry_epoch))
	# A retry stamped in the future (clock skew) counts as in progress.
	[ "$age" -lt "$DEADMAN_AGENT_RETRY_GRACE_SECONDS" ]
}

# Does the agent's recovery own the PassWall main switch right now?
deadman_agent_owns_passwall() {
	case "$(deadman_state_field '@.control_plane_recovery.phase')" in
	direct_settle | reboot_wait | post_reboot_check | passwall_retry_wait | operator_attention) return 0 ;;
	esac
	return 1
}

# Log only when the dead-man's informational state changes, so a long panel
# outage does not scroll the 64 KiB syslog ring away.
deadman_note_state() {
	if [ "$(cat "$STATE_FILE" 2>/dev/null || true)" != "$1" ]; then
		log "$2"
		mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || true
		echo "$1" > "$STATE_FILE"
	fi
}

deadman_release_ownership() {
	[ -f "$DEADMAN_OWNER_MARKER" ] || return 0
	rm -f "$DEADMAN_OWNER_MARKER" 2>/dev/null || true
	log "DEAD-MAN: $1; releasing the watchdog's direct-mode ownership"
	if [ "$(cat "$STATE_FILE" 2>/dev/null || true)" = "deadman-direct" ]; then
		rm -f "$STATE_FILE" 2>/dev/null || true
	fi
}

# Forget the informational hold/defer state once contact is back, so the
# next outage logs its first decision again.
deadman_clear_note() {
	case "$(cat "$STATE_FILE" 2>/dev/null || true)" in
	deadman-hold-* | deadman-defer) rm -f "$STATE_FILE" 2>/dev/null || true ;;
	esac
}


# Orchestrates the dead-man's switch: gather on-disk signals, ask the pure
# decision function, prove the proxy's state, act + log. Safe to call
# unconditionally; it self-guards on every precondition.
run_deadman_check() {
	run_lock_epoch="$(now_epoch)"
	if ! deadman_try_lock "$DEADMAN_LOCK_DIR" "$run_lock_epoch" "$DEADMAN_LOCK_STALE_SECONDS"; then
		return 0
	fi
	deadman_check_locked "$run_lock_epoch"
	deadman_unlock "$DEADMAN_LOCK_DIR" "$run_lock_epoch"
}

deadman_check_locked() {
	now="$1"

	# Not "passwall_enabled": POSIX sh has no locals and
	# should_fail_safe_to_direct below assigns that name.
	pw_enabled="$(uci -q get passwall2.@global[0].enabled 2>/dev/null || printf 0)"
	[ -n "$pw_enabled" ] || pw_enabled=0

	router_id="$(deadman_state_field '@.router_id')"
	agent_token="$(deadman_state_field '@.agent_token')"
	is_onboarded=0
	if [ -n "$router_id" ] && [ -n "$agent_token" ]; then
		is_onboarded=1
	fi

	last_contact_raw="$(deadman_state_field '@.control_plane_recovery.last_successful_control_plane_at')"
	last_contact_epoch="$(deadman_rfc3339_to_epoch "$last_contact_raw")"

	# Establish/age the boot grace marker every tick.
	if deadman_past_boot_grace "$now"; then
		boot_grace_ok=1
	else
		boot_grace_ok=0
	fi

	# Is the dead-man armed (onboarded, no recent contact)? Evaluated as if
	# PassWall were on, so the same answer drives both directions.
	if should_fail_safe_to_direct "$last_contact_epoch" "$now" 1 "$is_onboarded" "$boot_grace_ok"; then
		contact_stale=1
	else
		contact_stale=0
	fi
	if [ -n "$last_contact_epoch" ]; then
		contact_age="$((now - last_contact_epoch))s"
	else
		contact_age="never"
	fi

	if [ "$pw_enabled" = "1" ]; then
		# Someone turned PassWall back on (agent rescue, operator, owner): our
		# direct, if any, is over.
		deadman_release_ownership "passwall2 is enabled again"
		if [ "$contact_stale" != "1" ]; then
			deadman_clear_note
			return 0
		fi
		if deadman_agent_retry_in_progress "$now"; then
			deadman_note_state deadman-defer "DEAD-MAN: no control-plane contact (last ${contact_age}) but the agent is judging its own proxy retry; not interfering"
			return 0
		fi
		if ! deadman_action_cooldown_elapsed "$now"; then
			return 0
		fi
		deadman_probe_due "$now" || return 0
		deadman_mark_probe "$now"
		deadman_proxy_verdict
		verdict=$?
		case "$verdict" in
		0)
			deadman_note_state deadman-hold-alive "DEAD-MAN: no control-plane contact (last ${contact_age}) but the proxy is alive (${DEADMAN_VERDICT_DETAIL}); keeping proxy mode — a panel outage alone never disables the VPN"
			;;
		2)
			deadman_note_state deadman-hold-inconclusive "DEAD-MAN: no control-plane contact (last ${contact_age}); proxy verdict inconclusive (${DEADMAN_VERDICT_DETAIL}); keeping proxy mode"
			;;
		*)
			log "DEAD-MAN: no control-plane contact (last ${contact_age}, threshold $(deadman_threshold_seconds)s) and the proxy is dead (url_test_node: ${DEADMAN_VERDICT_DETAIL}); failing safe to direct (uci disable passwall2 + restart)"
			deadman_fail_safe_to_direct
			mkdir -p "$(dirname "$DEADMAN_OWNER_MARKER")" 2>/dev/null || true
			printf '%s' "$now" > "$DEADMAN_OWNER_MARKER" 2>/dev/null || true
			deadman_mark_action "$now"
			echo deadman-direct > "$STATE_FILE"
			;;
		esac
		return 0
	fi

	# PassWall is off. Only a direct the watchdog created is its business, and
	# it stays the watchdog's until a node answers: panel contact says nothing
	# about the proxy (the agent's own resume from an external direct waits a
	# RebootCooldown), and a clock without RTC, a missing timestamp during boot
	# grace or a disabled threshold must not orphan the direct either. The
	# agent takes ownership by writing the main switch, which deletes the
	# marker, or by parking the router in one of its recovery phases.
	[ -f "$DEADMAN_OWNER_MARKER" ] || return 0
	if deadman_agent_owns_passwall; then
		deadman_release_ownership "the agent's recovery has taken over PassWall"
		return 0
	fi
	if ! deadman_action_cooldown_elapsed "$now" restore; then
		return 0
	fi
	deadman_probe_due "$now" || return 0
	deadman_mark_probe "$now"
	if deadman_proxy_verdict; then
		log "DEAD-MAN: proxy is alive again (${DEADMAN_VERDICT_DETAIL}; last control-plane contact ${contact_age}); restoring the watchdog's direct to proxy mode (uci enable passwall2 + restart)"
		deadman_restore_proxy
		rm -f "$DEADMAN_OWNER_MARKER" 2>/dev/null || true
		deadman_mark_action "$now"
		rm -f "$STATE_FILE" 2>/dev/null || true
	fi
	return 0
}

# Does vctl own this router? Its handover marker, its running service, or its
# nftables table. `nft list tables` only lists names (never the sets, which
# cost tens of MB on a 234 MB box).
vctl_owns_router() {
	for marker in $VCTL_HANDOVER_MARKERS; do
		[ -f "$marker" ] && return 0
	done
	if [ -x "$VCTL_INIT" ] && "$VCTL_INIT" running >/dev/null 2>&1; then
		return 0
	fi
	if command -v nft >/dev/null 2>&1 && nft list tables 2>/dev/null | grep -qx 'table inet vctl'; then
		return 0
	fi
	return 1
}

# Why the legacy agent must not be started now, or nothing (start allowed).
legacy_start_hold_reason() {
	if vctl_owns_router; then
		printf 'vctl owns this router'
		return 0
	fi
	if ! "$INIT_SCRIPT" enabled >/dev/null 2>&1; then
		printf '%s is disabled' "$INIT_SCRIPT"
		return 0
	fi
	return 0
}

# Log a hold once per state change (the 64 KiB syslog ring).
note_hold() {
	if [ "$(cat "$STATE_FILE" 2>/dev/null || true)" != "$1" ]; then
		log "$2"
		mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || true
		echo "$1" > "$STATE_FILE"
	fi
}

# When sourced for testing, stop here: expose the helpers/decision function
# without running the watchdog's recovery flow or touching system state.
if [ -n "${VECTRA_WATCHDOG_LIB_ONLY:-}" ]; then
	return 0 2>/dev/null || exit 0
fi

# Quick sanity: is init.d/vectra-controller even installed?
if [ ! -x "$INIT_SCRIPT" ]; then
	exit 0
fi

# Branch 1: binary missing or empty. This is the r27-incident scenario.
# A self-update still under verification left a rollback copy: its guard puts
# the previous version back, offline. Without one we can't auto-recover, so we
# log loud-and-clear and exit. Operator needs to SSH in.
if [ ! -f "$AGENT_BIN" ] || [ ! -s "$AGENT_BIN" ]; then
	if [ -f "$UPDATE_GUARD" ] && [ -f "$UPDATE_GUARD_META" ]; then
		hold_reason="$(legacy_start_hold_reason)"
		if [ -n "$hold_reason" ]; then
			note_hold missing-held "CRITICAL: $AGENT_BIN is missing or empty and a rollback copy exists, but $hold_reason; not restoring the legacy agent"
			exit 0
		fi
		log "CRITICAL: $AGENT_BIN is missing or empty; restoring the previous version from the self-update rollback copy ($UPDATE_GUARD)"
		if sh "$UPDATE_GUARD" rollback "watchdog: $AGENT_BIN missing or empty" >/dev/null 2>&1; then
			log "previous controller version restored from the rollback copy"
			rm -f "$STATE_FILE"
		else
			log "WARN: restoring from the rollback copy failed; will retry next tick"
		fi
		exit 0
	fi
	# Only log once per state-change to avoid spamming the syslog ring buffer.
	if [ ! -f "$STATE_FILE" ] || [ "$(cat "$STATE_FILE" 2>/dev/null)" != "missing" ]; then
		log "CRITICAL: $AGENT_BIN is missing or empty — controller cannot run; manual recovery required (scp the correct .ipk + opkg install /tmp/<ipk>)"
		echo missing > "$STATE_FILE"
	fi
	exit 0
fi

if [ ! -x "$AGENT_BIN" ]; then
	log "WARN: $AGENT_BIN is not executable — chmod +x to repair"
	chmod 0755 "$AGENT_BIN" 2>/dev/null || true
	echo not-executable > "$STATE_FILE"
fi

# Branch 2: binary OK, but process not running. Probably procd gave up.
if ! pgrep -f "$AGENT_BIN" >/dev/null 2>&1; then
	hold_reason="$(legacy_start_hold_reason)"
	if [ -n "$hold_reason" ]; then
		note_hold held "controller process missing but $hold_reason; not starting the legacy agent"
		exit 0
	fi
	last_restart="$(read_last_restart_epoch)"
	now="$(now_epoch)"
	delta=$((now - last_restart))
	if [ "$delta" -lt "$RESTART_THROTTLE_SECONDS" ]; then
		# Recent attempt; let procd / kernel work and re-check next tick.
		log "controller process missing but last restart was ${delta}s ago (< ${RESTART_THROTTLE_SECONDS}s throttle); skipping"
		exit 0
	fi
	log "controller process missing; attempting init.d restart (last attempt ${delta}s ago)"
	mark_restart_attempt
	# `enable` is idempotent (a disabled init script never gets here: that is
	# an intentional hold, see legacy_start_hold_reason). `start` is preferred over `restart` for the "not running"
	# case since restart would error on a service that's already stopped on
	# some procd builds.
	"$INIT_SCRIPT" enable >/dev/null 2>&1 || true
	"$INIT_SCRIPT" start >/dev/null 2>&1 || true
	# Give procd a moment then re-check; reporting success/failure helps
	# operators triage from `logread` without an extra SSH round-trip.
	sleep 3
	if pgrep -f "$AGENT_BIN" >/dev/null 2>&1; then
		log "controller process restarted successfully"
		rm -f "$STATE_FILE"
	else
		log "WARN: controller process still missing after init.d start; will retry next tick"
	fi
	exit 0
fi

# Clear a prior process-recovery marker so the next transition logs again.
# Dead-man markers (deadman-*) belong to run_deadman_check below.
case "$(cat "$STATE_FILE" 2>/dev/null || true)" in
missing | not-executable | held | missing-held)
	log "controller recovered; clearing watchdog state"
	rm -f "$STATE_FILE"
	;;
esac

# Branch 3: process is alive. The binary exists and a controller process is
# running — but "process alive" does NOT mean "reaching the panel". This is
# exactly where the proxy strand hides, so run the dead-man's switch (GAP-2).
# It acts only on an onboarded router with no recent control-plane contact,
# and then only on url_test_node proof: a dead proxy goes direct, a proxy
# that answers again comes back. A panel outage alone is a no-op.
run_deadman_check
exit 0
