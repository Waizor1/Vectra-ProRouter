# The fleet's PassWall2 configuration, shaped like the test router's
# (2026-09-29): the panel's shunt node with its slots, four bound nodes of
# the fleet's three kinds and one unbound. Every credential is made up.

config global_forwarding 'global_forwarding1'
	option accept_icmp '0'
	option ipv6_tproxy '0'
	option prefer_nft '1'
	option tcp_no_redir_ports 'disable'
	option tcp_proxy_way 'redirect'
	option tcp_redir_ports '1:65535'
	option udp_no_redir_ports 'disable'
	option udp_redir_ports '1:65535'

config global_xray 'global_xray1'
	option buffer_size '0'
	option fragment '0'
	option noise '0'
	option sniffing_override_dest '0'

config global_other 'global_other1'
	option auto_detection_time 'tcping'
	option show_node_info '1'

config global 'vectra_global'
	option enabled '0'
	option node 'myshunt'
	option localhost_proxy '1'
	option client_proxy '1'
	option node_socks_port '1070'
	option socks_enabled '0'
	option direct_dns_query_strategy 'UseIP'
	option remote_dns_protocol 'doh'
	option remote_dns_doh 'https://dns.google/dns-query'
	option remote_dns_detour 'direct'
	option remote_dns_query_strategy 'UseIPv4'
	option dns_hosts 'dns.google 8.8.8.8
dns.google.com 8.8.8.8'
	option dns_redirect '1'
	option log_node '0'
	option loglevel 'error'

config global_rules 'vectra_global_rules'
	option v2ray_location_asset '/usr/share/v2ray/'
	option auto_update '0'

config global_subscribe 'vectra_global_subscribe'
	option filter_keyword_mode '1'
	list filter_discard_list 'Guise'
	option vless_type 'xray'

config shunt_rules 'direct'
	option remarks 'direct'
	option domain_list 'geosite:russia-outside
domain:gosuslugi.example
domain:bank.example
full:direct.example
regexp:^cdn[0-9]+\.direct\.example$'
	option ip_list 'geoip:DIRECT'

config shunt_rules 'WorldProxy'
	option remarks 'WorldProxy'
	option network 'tcp,udp'
	option domain_list 'geosite:META
geosite:TELEGRAM
geosite:DISCORD
domain:world.example
full:api.world.example'
	option ip_list '91.108.4.0/22
91.108.56.0/22
149.154.160.0/20
2001:67c:4e8::/48
203.0.113.7'

config shunt_rules 'YouTube'
	option remarks 'YouTube'
	option domain_list 'geosite:YOUTUBE'

config shunt_rules 'Special'
	option remarks 'Special'
	option network 'tcp,udp'
	option domain_list 'domain:special-one.example
domain:special-two.example
full:x.special.example'

config shunt_rules 'Tiktok'
	option remarks 'Tiktok'
	option domain_list 'geosite:TIKTOK'

config shunt_rules 'DiscordVoiceUdp'
	option remarks 'DiscordVoiceUdp'
	option network 'udp'
	option port '19294-19344,50000-50100'

config nodes 'myshunt'
	option remarks 'Маршрутизатор '
	option enabled '1'
	option group 'default'
	option type 'Xray'
	option protocol '_shunt'
	option direct '_direct'
	option WorldProxy 'nodeNL01'
	option YouTube 'nodeNL01'
	option Special 'nodeFR01'
	option Tiktok 'nodeBY01'
	option DiscordVoiceUdp 'nodeFI01'
	option China '_direct'
	option QUIC '_blackhole'
	option GFW '_default'
	option Special_fakedns '1'
	option Tiktok_fakedns '1'
	option WorldProxy_fakedns '1'
	option YouTube_fakedns '1'
	option domainMatcher 'hybrid'
	option domainStrategy 'IPOnDemand'
	option enable_geoview_ip '1'
	option fakedns '1'
	option write_ipset_direct '1'

config nodes 'nodeBY01'
	option flow 'xtls-rprx-vision'
	option protocol 'vless'
	option tcp_guise 'none'
	option group 'Sub'
	option port '443'
	option uuid '11111111-1111-4111-8111-111111111111'
	option remarks '🇧🇾 Беларусь '
	option add_mode '2'
	option tls_allowInsecure '1'
	option type 'Xray'
	option timeout '60'
	option tls '1'
	option fingerprint 'firefox'
	option reality_shortId 'a1b2c3d4'
	option reality_spiderX '/'
	option reality '1'
	option tls_serverName 'by.node.example'
	option reality_publicKey 'AbCdEfGhIjKlMnOpQrStUvWxYz0123456789-_AbCdE'
	option address 'By.Node.Example'
	option encryption 'none'
	option utls '1'
	option transport 'raw'

config nodes 'nodeFI01'
	option grpc_mode 'gun'
	option protocol 'vless'
	option encryption 'none'
	option group 'Sub'
	option port '50054'
	option remarks '🇷🇺🇫🇮 ⚡Финляндия YouTube 🚫Ad🚫'
	option uuid '22222222-2222-4222-8222-222222222222'
	option add_mode '2'
	option type 'Xray'
	option timeout '60'
	option fingerprint 'firefox'
	option tls_allowInsecure '1'
	option reality_spiderX '/'
	option reality_shortId 'b2c3d4e5'
	option tls_serverName 'fi.bridge.example'
	option tls '1'
	option reality_publicKey 'BcDeFgHiJkLmNoPqRsTuVwXyZa1234567890-_BcDeF'
	option utls '1'
	option reality '1'
	option address 'fi.bridge.example'
	option transport 'grpc'

config nodes 'nodeFR01'
	option grpc_mode 'gun'
	option protocol 'vless'
	option encryption 'none'
	option group 'Sub'
	option port '50057'
	option remarks '🇷🇺🇫🇷 Франция '
	option uuid '33333333-3333-4333-8333-333333333333'
	option add_mode '2'
	option type 'Xray'
	option timeout '60'
	option fingerprint 'firefox'
	option tls_allowInsecure '1'
	option reality_spiderX '/'
	option reality_shortId 'c3d4e5f6'
	option tls_serverName 'fr.bridge.example'
	option tls '1'
	option reality_publicKey 'CdEfGhIjKlMnOpQrStUvWxYzAb2345678901-_CdEfG'
	option utls '1'
	option reality '1'
	option address 'fr.bridge.example'
	option transport 'grpc'

config nodes 'nodeNL01'
	option grpc_mode 'gun'
	option protocol 'vless'
	option encryption 'none'
	option group 'Sub'
	option port '50055'
	option remarks '🇷🇺🇳🇱 Нидерланды'
	option uuid '44444444-4444-4444-8444-444444444444'
	option add_mode '2'
	option type 'Xray'
	option timeout '60'
	option fingerprint 'firefox'
	option tls_allowInsecure '1'
	option reality_spiderX '/'
	option reality_shortId 'd4e5f6a7'
	option tls_serverName 'nl.bridge.example'
	option tls '1'
	option reality_publicKey 'DeFgHiJkLmNoPqRsTuVwXyZaBc3456789012-_DeFgH'
	option utls '1'
	option reality '1'
	option address 'nl.bridge.example'
	option transport 'grpc'

config nodes 'nodeXH01'
	option tls '1'
	option protocol 'vless'
	option encryption 'none'
	option group 'Sub'
	option xhttp_host 'media.xhttp.example'
	option port '443'
	option xhttp_mode 'packet-up'
	option remarks '🇷🇺⚡ Обход глушилок (Скоростной)'
	option xhttp_extra 'eyJ4bXV4Ijp7ImNNYXhSZXVzZVRpbWVzIjoiMTI4LTI1NiIsIm1heENvbmN1cnJlbmN5IjoiOC0xNiJ9fQ=='
	option uuid '55555555-5555-4555-8555-555555555555'
	option add_mode '2'
	option type 'Xray'
	option timeout '60'
	option fingerprint 'firefox'
	option tls_allowInsecure '1'
	option tls_serverName 'media.xhttp.example'
	option utls '1'
	option alpn 'h2,http/1.1'
	option address 'media.xhttp.example'
	option use_xhttp_extra '1'
	option xhttp_path '/api/v4/media/session/sync'
	option transport 'xhttp'

config subscribe_list 'sub1'
	option remark 'Sub'
	option url '/tmp/refresh-feed.txt'
	option enabled '1'
	option add_mode '2'
	option access_mode 'direct'
	option allowInsecure '1'
	option filter_keyword_mode '5'
	option hwid '1'
	option ss_type 'global'
	option trojan_type 'global'
	option vless_type 'global'
	option vmess_type 'global'
	option hysteria2_type 'global'
	option domain_strategy 'global'
	option md5 '00000000000000000000000000000000'
