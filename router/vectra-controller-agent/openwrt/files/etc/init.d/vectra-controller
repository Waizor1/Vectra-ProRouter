#!/bin/sh /etc/rc.common

START=95
STOP=20
USE_PROCD=1

CONF="vectra-controller"
SECTION="main"
RENDERER="/usr/libexec/vectra-controller/render-config.sh"
CONFIG_JSON="/var/run/vectra-controller/config.json"
AGENT_BIN="/usr/sbin/vectra-controller-agent"
CONTROLPLANE_DIRECT="/usr/libexec/vectra-controller/controlplane-direct.sh"

# Re-assert the control-plane DIRECT carve-out (nft table + fw4 include).
# Belt-and-suspenders to the /etc/hotplug.d/firewall hook: this guarantees the
# carve-out exists from the moment our service comes up at boot, even before the
# firewall hotplug subsystem has fired. Best-effort and non-fatal: a failure here
# must NEVER prevent the agent from starting.
apply_controlplane_direct() {
	[ -x "$CONTROLPLANE_DIRECT" ] && "$CONTROLPLANE_DIRECT" apply >/dev/null 2>&1
	return 0
}

# boot() runs once at system startup (procd). The carve-out's backing state
# (in-kernel nft table + tmpfs include) does NOT survive a reboot and the
# uci-default that first created it has been deleted by OpenWrt after first run,
# so we rebuild it here. Must still bring the service up normally afterwards.
boot() {
	apply_controlplane_direct
	start "$@"
}

start_service() {
	local enabled
	[ "${VECTRA_SKIP_POSTINST_RESTART:-}" = "1" ] && return 0

	config_load "$CONF"
	config_get_bool enabled "$SECTION" enabled 1
	[ "$enabled" -eq 1 ] || return 0

	[ -x "$RENDERER" ] || return 1
	[ -x "$AGENT_BIN" ] || return 1

	mkdir -p /var/run/vectra-controller
	"$RENDERER" "$CONFIG_JSON" || return 1

	# Ensure the control-plane DIRECT carve-out is present on EVERY service start
	# (boot, restart, self-update restart, reload) — not just boot(). A controller
	# self-update performs `restart` (stop+start_service), which does NOT run
	# boot(); without this the nft carve-out would be missing until the next
	# reboot or fw4 reload, silently leaving the panel link subject to tproxy.
	# Idempotent + non-fatal (never blocks the agent from starting).
	apply_controlplane_direct

	procd_open_instance
	procd_set_param command "$AGENT_BIN" -config "$CONFIG_JSON" -once=false
	procd_set_param respawn 15 5 20
	procd_set_param stderr 1
	procd_set_param stdout 1
	procd_set_param file /etc/config/vectra-controller
	procd_close_instance
}

reload_service() {
	[ "${VECTRA_SKIP_POSTINST_RESTART:-}" = "1" ] && return 0
	stop
	start
}
